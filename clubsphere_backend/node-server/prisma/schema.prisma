generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  phone                   String?
  avatarUrl               String?
  isSuperAdmin            Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  memberships             OrganizationMembership[]
  bookings                Booking[]
  orders                  Order[]
  assignedTasks           TaskAssignment[]
  expenseClaimsSubmitted  ExpenseClaim[]           @relation("ClaimantUser")
  expenseClaimsReviewed   ExpenseClaim[]           @relation("ReviewerUser")
  auditLogs               AuditLog[]
  notifications           Notification[]
}

model Organization {
  id                    String                   @id @default(uuid())
  name                  String
  slug                  String                   @unique
  description           String?
  logoUrl               String?
  primaryColor          String?                  @default("#8b5cf6")
  currency              String                   @default("USD")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  memberships           OrganizationMembership[]
  membershipPlans       MembershipPlan[]
  events                Event[]
  announcements         Announcement[]
  products              MerchandiseProduct[]
  campaigns             FundraisingCampaign[]
  tasks                 VolunteerTask[]
  expenseClaims         ExpenseClaim[]
  financialTransactions FinancialTransaction[]
  budgets               Budget[]
  auditLogs             AuditLog[]
  orders                Order[]
}

model OrganizationMembership {
  id                String               @id @default(uuid())
  userId            String
  organizationId    String
  role              String               // SUPER_ADMIN, CLUB_ADMIN, TREASURER, EVENT_MANAGER, VOLUNTEER, MEMBER
  status            String               @default("ACTIVE") // ACTIVE, PENDING, EXPIRED, ARCHIVED
  joinDate          DateTime             @default(now())
  expiryDate        DateTime?
  tier              String               @default("STANDARD")
  studentId         String?
  department        String?
  emergencyContact  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions     MemberSubscription[]

  @@unique([userId, organizationId])
}

model MembershipPlan {
  id                  String               @id @default(uuid())
  organizationId      String
  name                String
  description         String?
  price               Float                @default(0.0)
  durationMonths      Int                  @default(12)
  benefits            String               @default("[]") // JSON array of string benefits
  discountPercentage  Float                @default(0.0)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions       MemberSubscription[]
}

model MemberSubscription {
  id                    String              @id @default(uuid())
  membershipId          String
  planId                String
  startDate             DateTime            @default(now())
  endDate               DateTime
  status                String              @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  renewalReminderSentAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  membership            OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  plan                  MembershipPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments              MembershipPayment[]
}

model MembershipPayment {
  id                   String             @id @default(uuid())
  subscriptionId       String
  amount               Float
  currency             String             @default("USD")
  paymentMethod        String             @default("DEMO_CARD")
  status               String             @default("COMPLETED") // COMPLETED, PENDING, REFUNDED
  transactionReference String             @unique
  paidAt               DateTime           @default(now())

  subscription         MemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Event {
  id                    String                 @id @default(uuid())
  organizationId        String
  title                 String
  description           String
  category              String                 @default("GENERAL") // CULTURAL, ACADEMIC, SOCIAL, COMPETITION, WORKSHOP
  venue                 String
  isOnline              Boolean                @default(false)
  meetingUrl            String?
  bannerUrl             String?
  startDate             DateTime
  endDate               DateTime
  capacity              Int
  registrationOpensAt   DateTime
  registrationClosesAt  DateTime
  status                String                 @default("DRAFT") // DRAFT, PUBLISHED, SOLD_OUT, CLOSED, COMPLETED, CANCELLED
  budget                Float                  @default(0.0)
  cancellationPolicy    String?
  organizerInfo         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketTypes           TicketType[]
  bookings              Booking[]
  tickets               Ticket[]
  checkIns              CheckIn[]
  financialTransactions FinancialTransaction[]
}

model TicketType {
  id                 String    @id @default(uuid())
  eventId            String
  name               String
  description        String?
  memberPrice        Float     @default(0.0)
  nonMemberPrice     Float     @default(0.0)
  totalQuantity      Int
  remainingQuantity  Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets            Ticket[]
}

model Booking {
  id               String    @id @default(uuid())
  eventId          String
  userId           String
  bookingReference String    @unique
  totalAmount      Float
  status           String    @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED, REFUNDED
  paymentStatus    String    @default("PAID") // PAID, UNPAID, REFUNDED
  idempotencyKey   String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  payment          Payment?
}

model Ticket {
  id                String     @id @default(uuid())
  bookingId         String
  ticketTypeId      String
  eventId           String
  ticketCode        String     @unique
  qrSecret          String
  attendeeName      String
  attendeeEmail     String
  isCheckedIn       Boolean    @default(false)
  checkedInAt       DateTime?
  checkedInByUserId String?
  status            String     @default("VALID") // VALID, USED, CANCELLED
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  booking           Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType        TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  event             Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns          CheckIn[]
}

model CheckIn {
  id                String    @id @default(uuid())
  ticketId          String
  eventId           String
  checkedInByUserId String
  checkedInAt       DateTime  @default(now())
  checkInMethod     String    @default("QR_SCAN") // QR_SCAN, MANUAL
  notes             String?

  ticket            Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Announcement {
  id                   String       @id @default(uuid())
  organizationId       String
  authorId             String
  title                String
  content              String
  category             String       @default("GENERAL") // GENERAL, URGENT, EVENT, ACADEMIC, OPPORTUNITY
  targetAudience       String       @default("ALL_MEMBERS") // ALL_MEMBERS, ACTIVE_ONLY, VOLUNTEERS, EXECUTIVES
  status               String       @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  scheduledFor         DateTime?
  publishedAt          DateTime?    @default(now())
  emailSent            Boolean      @default(false)
  emailRecipientCount  Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MerchandiseProduct {
  id                    String           @id @default(uuid())
  organizationId        String
  name                  String
  description           String
  category              String           @default("APPAREL") // APPAREL, ACCESSORIES, STATIONERY, DRINKWARE
  basePrice             Float
  memberDiscountPercent Float            @default(0.0)
  imageUrl              String?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variants              ProductVariant[]
  orderItems            OrderItem[]
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  sku                String              @unique
  size               String?             // S, M, L, XL, XXL, Standard
  color              String?
  stockQuantity      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  product            MerchandiseProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
}

model InventoryMovement {
  id             String         @id @default(uuid())
  variantId      String
  quantityChange Int            // positive = restock/return, negative = sales
  previousStock  Int
  newStock       Int
  reason         String         // INITIAL, SALE, RESTOCK, RETURN, ADJUSTMENT, SPOILAGE
  reference      String?
  createdAt      DateTime       @default(now())

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Order {
  id             String        @id @default(uuid())
  organizationId String
  userId         String
  orderNumber    String        @unique
  subtotal       Float
  discount       Float         @default(0.0)
  totalAmount    Float
  status         String        @default("PAID") // PENDING, PAID, PROCESSING, FULFILLED, CANCELLED, REFUNDED
  paymentStatus  String        @default("PAID") // PAID, UNPAID, REFUNDED
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payment        Payment?
}

model OrderItem {
  id         String             @id @default(uuid())
  orderId    String
  productId  String
  variantId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    MerchandiseProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  bookingId      String?       @unique
  orderId        String?       @unique
  amount         Float
  currency       String        @default("USD")
  provider       String        @default("DEMO_PAYMENT")
  transactionId  String        @unique
  status         String        @default("SETTLED") // SETTLED, PENDING, FAILED, REFUNDED
  isDemo         Boolean       @default(true)
  paidAt         DateTime      @default(now())

  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model FundraisingCampaign {
  id                    String                 @id @default(uuid())
  organizationId        String
  coordinatorId         String
  title                 String
  description           String
  goalAmount            Float
  currentAmount         Float                  @default(0.0)
  startDate             DateTime
  endDate               DateTime
  status                String                 @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  financialTransactions FinancialTransaction[]
}

model VolunteerTask {
  id              String           @id @default(uuid())
  organizationId  String
  title           String
  description     String
  priority        String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String           @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED
  dueDate         DateTime?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments     TaskAssignment[]
}

model TaskAssignment {
  id         String        @id @default(uuid())
  taskId     String
  userId     String
  assignedAt DateTime      @default(now())

  task       VolunteerTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model ExpenseClaim {
  id                   String                @id @default(uuid())
  organizationId       String
  claimantId           String
  title                String
  description          String
  amount               Float
  category             String                // EVENT_SUPPLIES, TRAVEL, REFRESHMENTS, MARKETING, PRINTING, OTHER
  receiptUrl           String?
  status               String                @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewNotes          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  claimant             User                  @relation("ClaimantUser", fields: [claimantId], references: [id], onDelete: Cascade)
  reviewer             User?                 @relation("ReviewerUser", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  financialTransaction FinancialTransaction?
}

model FinancialTransaction {
  id              String         @id @default(uuid())
  organizationId  String
  type            String         // INCOME, EXPENSE
  category        String         // MEMBERSHIP_DUES, EVENT_TICKETS, MERCHANDISE, FUNDRAISING, OPERATING_EXPENSES, EVENT_EXPENSES, MERCH_COSTS, VOLUNTEER_REIMBURSEMENT, FEES, REFUND
  amount          Float
  currency        String         @default("USD")
  status          String         @default("SETTLED") // SETTLED, PENDING, CANCELLED, REVERSED
  description     String
  reference       String?
  eventId         String?
  campaignId      String?
  expenseClaimId  String?        @unique
  orderId         String?
  transactionDate DateTime       @default(now())
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event           Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  campaign        FundraisingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  expenseClaim    ExpenseClaim?  @relation(fields: [expenseClaimId], references: [id], onDelete: SetNull)
}

model Budget {
  id              String       @id @default(uuid())
  organizationId  String
  category        String
  allocatedAmount Float
  fiscalYear      Int
  period          String       @default("ANNUAL") // ANNUAL, Q1, Q2, Q3, Q4
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorUserId    String
  action         String
  entityType     String
  entityId       String
  details        String       // JSON string of snapshot or changes
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
}
